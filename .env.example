# Copy to .env and replace every value. Never commit .env.
# These are placeholders for local development only.

# PostgreSQL container (docker-compose.yml)
POSTGRES_USER=shiplens
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shiplens
POSTGRES_PORT=5432

# Connection string used by the app (and by Prisma when DATABASE_MIGRATION_URL is unset).
# Must match the values above when using the local container.
DATABASE_URL="postgresql://shiplens:change-me@localhost:5432/shiplens?schema=public"

# Optional: owner connection used only for migrations. Set it when DATABASE_URL uses a
# restricted login role that is a member of shiplens_app (see README).
# DATABASE_MIGRATION_URL="postgresql://shiplens:change-me@localhost:5432/shiplens?schema=public"

# Port for `docker compose --profile app up`
APP_PORT=3000
