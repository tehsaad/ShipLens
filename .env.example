# Copy to .env and replace every value. Never commit .env.
# These are placeholders for local development only.

# PostgreSQL container (docker-compose.yml)
POSTGRES_USER=shiplens
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shiplens
POSTGRES_PORT=5432

# Connection string used by the app (and by Prisma when DATABASE_MIGRATION_URL is unset).
# Must match the values above when using the local container.
DATABASE_URL="postgresql://shiplens:change-me@localhost:5432/shiplens?schema=public"

# Optional: owner connection used only for migrations. Set it when DATABASE_URL uses a
# restricted login role that is a member of shiplens_app (see README).
# DATABASE_MIGRATION_URL="postgresql://shiplens:change-me@localhost:5432/shiplens?schema=public"

# Port for `docker compose --profile app up`
APP_PORT=3000

# Integration tests: a disposable database whose name ends in "_test".
# Its schema is dropped and recreated on every test run.
TEST_DATABASE_URL="postgresql://shiplens:change-me@localhost:5432/shiplens_test?schema=public"

# Auth.js: at least 32 random characters, e.g. `openssl rand -base64 32`. Required at boot.
AUTH_SECRET="replace-with-at-least-32-random-characters"
# Set to true behind a trusted reverse proxy (Render, docker compose).
AUTH_TRUST_HOST=true

# Seed script (npm run db:seed): password for every demo login, at least 12 characters.
# In the Docker image, setting it also loads the sample data on every container start.
SEED_DEMO_PASSWORD="replace-with-a-demo-password"
