// Prisma schema for the Branch-to-Head-Office Management Platform.
// Source of truth: docs/SPEC.md section 5, plus approved decisions 4, 5, 6 and 7 / amendment A1
// in docs/OPEN-QUESTIONS.md. Business rules that the database must enforce (the 7-day lock,
// correction limits, approved-week inserts, append-only audit log) live in SQL migrations.
//
// Every table has id (UUID), createdAt and updatedAt. Money is Decimal(14,2) in PKR.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  FINANCE_REVIEWER
  CONTENT_EDITOR
  BRANCH_LEAD
  HR_LEAD
}

enum Locale {
  en
  ur
}

enum BranchStatus {
  FORMING
  ACTIVE
  PAUSED
  CLOSED
}

enum Availability {
  WEEKDAYS
  WEEKENDS
  FLEXIBLE
}

enum ApplicationStatus {
  NEW
  ACCEPTED
  DECLINED
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum CollectionPurpose {
  GENERAL
  EVENT
  DONATION
  OTHER
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  RETURNED
  APPROVED
}

enum ContentType {
  PAGE
  PROGRAM
  ANNOUNCEMENT
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

model User {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Stored lowercased (checked in the database).
  email              String    @unique
  name               String
  passwordHash       String    @map("password_hash")
  role               Role
  /// Required when role is BRANCH_LEAD (checked in the database).
  branchId           String?   @map("branch_id") @db.Uuid
  isActive           Boolean   @default(true) @map("is_active")
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz(3)
  locale             Locale    @default(en)
  /// Decision 5: true for every user except seeded demo accounts (decision 5a).
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch                Branch?          @relation("BranchUsers", fields: [branchId], references: [id])
  ledBranches           Branch[]         @relation("BranchLead")
  decidedApplications   Application[]    @relation("ApplicationDecidedBy")
  enteredCollections    Collection[]     @relation("CollectionEnteredBy")
  routedCollections     Collection[]     @relation("CollectionRoutedBy")
  submittedReports      WeeklyReport[]   @relation("ReportSubmittedBy")
  reviewedReports       WeeklyReport[]   @relation("ReportReviewedBy")
  updatedContent        ContentEntry[]   @relation("ContentUpdatedBy")
  handledContactMessage ContactMessage[] @relation("ContactHandledBy")
  auditLogs             AuditLog[]       @relation("AuditActor")

  @@index([branchId])
  @@map("users")
}

model Branch {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// BR-<CITY3>-<NNN>, generated by the application inside a transaction.
  code         String       @unique
  name         String
  city         String
  status       BranchStatus @default(FORMING)
  leadUserId   String?      @map("lead_user_id") @db.Uuid
  openedAt     DateTime?    @map("opened_at") @db.Date
  /// Decision 4: optional public contact address.
  contactEmail String?      @map("contact_email")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  leadUser      User?          @relation("BranchLead", fields: [leadUserId], references: [id])
  users         User[]         @relation("BranchUsers")
  teams         Team[]
  applications  Application[]
  members       Member[]
  collections   Collection[]
  weeklyReports WeeklyReport[]
  events        Event[]
  results       Result[]

  @@index([leadUserId])
  @@index([status])
  @@map("branches")
}

model Team {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  branchId  String   @map("branch_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch  Branch       @relation(fields: [branchId], references: [id])
  members MemberTeam[]

  @@unique([branchId, name])
  @@map("teams")
}

model Application {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName          String            @map("full_name")
  email             String
  phone             String
  preferredBranchId String            @map("preferred_branch_id") @db.Uuid
  skills            String
  availability      Availability
  /// At least 50 characters (checked in the database).
  motivation        String
  /// Must be true (checked in the database).
  consentGiven      Boolean           @map("consent_given")
  status            ApplicationStatus @default(NEW)
  decidedById       String?           @map("decided_by_id") @db.Uuid
  decidedAt         DateTime?         @map("decided_at") @db.Timestamptz(3)
  /// Internal only; never shown to the applicant.
  declineReason     String?           @map("decline_reason")
  memberId          String?           @unique @map("member_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  preferredBranch Branch  @relation(fields: [preferredBranchId], references: [id])
  decidedBy       User?   @relation("ApplicationDecidedBy", fields: [decidedById], references: [id])
  member          Member? @relation("ApplicationMember", fields: [memberId], references: [id])
  createdMember   Member? @relation("MemberFromApplication")

  @@index([status, createdAt])
  @@index([preferredBranchId])
  @@map("applications")
}

model Member {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// MEM-<6-digit sequence>, generated by the database.
  memberCode    String       @unique @default(dbgenerated("next_member_code()")) @map("member_code")
  fullName      String       @map("full_name")
  email         String
  phone         String
  branchId      String       @map("branch_id") @db.Uuid
  status        MemberStatus @default(ACTIVE)
  joinedAt      DateTime     @map("joined_at") @db.Date
  applicationId String?      @unique @map("application_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch      Branch       @relation(fields: [branchId], references: [id])
  application Application? @relation("MemberFromApplication", fields: [applicationId], references: [id])
  linkedFrom  Application? @relation("ApplicationMember")
  teams       MemberTeam[]

  @@index([branchId, status])
  @@index([joinedAt])
  @@map("members")
}

model MemberTeam {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId   String   @map("member_id") @db.Uuid
  teamId     String   @map("team_id") @db.Uuid
  roleInTeam String?  @map("role_in_team")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  member Member @relation(fields: [memberId], references: [id])
  team   Team   @relation(fields: [teamId], references: [id])

  @@unique([memberId, teamId])
  @@index([teamId])
  @@map("member_teams")
}

model Collection {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId             String            @map("branch_id") @db.Uuid
  /// > 0 for normal entries; non-zero for correction entries (amendment A1).
  amount               Decimal           @db.Decimal(14, 2)
  collectedOn          DateTime          @map("collected_on") @db.Date
  purpose              CollectionPurpose
  description          String?
  enteredById          String            @map("entered_by_id") @db.Uuid
  /// createdAt + 7 days, always set by the database on insert.
  lockedAt             DateTime          @default(dbgenerated("(now() + '7 days'::interval)")) @map("locked_at") @db.Timestamptz(3)
  routedAt             DateTime?         @map("routed_at") @db.Timestamptz(3)
  routedById           String?           @map("routed_by_id") @db.Uuid
  routingReference     String?           @map("routing_reference")
  /// Amendment A1: set only on correction entries.
  correctsCollectionId String?           @map("corrects_collection_id") @db.Uuid
  /// Amendment A1: the reason, required on correction entries.
  correctionNote       String?           @map("correction_note")
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch      Branch       @relation(fields: [branchId], references: [id])
  enteredBy   User         @relation("CollectionEnteredBy", fields: [enteredById], references: [id])
  routedBy    User?        @relation("CollectionRoutedBy", fields: [routedById], references: [id])
  corrects    Collection?  @relation("CollectionCorrections", fields: [correctsCollectionId], references: [id])
  corrections Collection[] @relation("CollectionCorrections")

  @@index([branchId, collectedOn])
  @@index([routedAt])
  @@index([correctsCollectionId])
  @@map("collections")
}

model WeeklyReport {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId       String       @map("branch_id") @db.Uuid
  /// Monday of the week, Asia/Karachi (checked in the database).
  weekStart      DateTime     @map("week_start") @db.Date
  status         ReportStatus @default(DRAFT)
  /// { collectionsTotal, collectionsCount, newMembers, activeMembers }, frozen on submit.
  totalsSnapshot Json?        @map("totals_snapshot")
  leadNotes      String?      @map("lead_notes")
  submittedAt    DateTime?    @map("submitted_at") @db.Timestamptz(3)
  submittedById  String?      @map("submitted_by_id") @db.Uuid
  reviewedAt     DateTime?    @map("reviewed_at") @db.Timestamptz(3)
  reviewedById   String?      @map("reviewed_by_id") @db.Uuid
  reviewComment  String?      @map("review_comment")
  approvedAt     DateTime?    @map("approved_at") @db.Timestamptz(3)
  /// Optimistic locking.
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch      Branch @relation(fields: [branchId], references: [id])
  submittedBy User?  @relation("ReportSubmittedBy", fields: [submittedById], references: [id])
  reviewedBy  User?  @relation("ReportReviewedBy", fields: [reviewedById], references: [id])

  @@unique([branchId, weekStart])
  @@index([status, submittedAt])
  @@map("weekly_reports")
}

model ContentEntry {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type        ContentType
  slug        String
  locale      Locale
  title       String
  /// Markdown, sanitised on render.
  body        String
  /// Section 7.2: edits to a PUBLISHED entry wait here until republished; the public site
  /// keeps showing title and body. Null when there are no pending edits.
  draftTitle  String?       @map("draft_title")
  draftBody   String?       @map("draft_body")
  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?     @map("published_at") @db.Timestamptz(3)
  updatedById String?       @map("updated_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy User? @relation("ContentUpdatedBy", fields: [updatedById], references: [id])

  @@unique([type, slug, locale])
  @@index([type, locale, status])
  @@map("content_entries")
}

model Event {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Decision 6: separate localised titles; Urdu falls back to English.
  titleEn   String        @map("title_en")
  titleUr   String?       @map("title_ur")
  startsAt  DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime      @map("ends_at") @db.Timestamptz(3)
  location  String
  branchId  String?       @map("branch_id") @db.Uuid
  status    PublishStatus @default(DRAFT)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([status, startsAt])
  @@index([branchId])
  @@map("events")
}

model ContactMessage {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  email       String
  message     String
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  handledById String?   @map("handled_by_id") @db.Uuid
  handledAt   DateTime? @map("handled_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  handledBy User? @relation("ContactHandledBy", fields: [handledById], references: [id])

  @@index([receivedAt])
  @@map("contact_messages")
}

/// Append-only: UPDATE, DELETE and TRUNCATE are rejected by a trigger, and the
/// application's database role is granted only SELECT and INSERT.
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorRole  Role?    @map("actor_role")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  branchId   String?  @map("branch_id") @db.Uuid
  before     Json?
  after      Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([branchId, createdAt])
  @@map("audit_logs")
}

/// A published result or achievement shown to the public (the "portfolio"). Network-level
/// when branchId is null, otherwise owned by one branch. Bilingual, with an optional image
/// stored alongside in result_images.
model Result {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId       String?       @map("branch_id") @db.Uuid
  titleEn        String        @map("title_en")
  titleUr        String?       @map("title_ur")
  bodyEn         String        @map("body_en")
  bodyUr         String?       @map("body_ur")
  happenedOn     DateTime?     @map("happened_on") @db.Date
  status         PublishStatus @default(DRAFT)
  publishedAt    DateTime?     @map("published_at") @db.Timestamptz(3)
  /// Alt text for the image, required when an image is attached (accessibility).
  imageAltEn     String?       @map("image_alt_en")
  imageAltUr     String?       @map("image_alt_ur")
  /// Set when an image is present; also the cache-busting version for the image URL.
  imageUpdatedAt DateTime?     @map("image_updated_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch Branch?      @relation(fields: [branchId], references: [id])
  image  ResultImage?

  @@index([status, publishedAt])
  @@index([branchId])
  @@map("results")
}

/// The image bytes for a result, kept in its own table so result queries never pull them.
/// Served same-origin by /api/media/results/[id] (the CSP forbids external image hosts).
model ResultImage {
  resultId    String   @id @map("result_id") @db.Uuid
  data        Bytes
  contentType String   @map("content_type")
  byteSize    Int      @map("byte_size")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  result Result @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@map("result_images")
}
